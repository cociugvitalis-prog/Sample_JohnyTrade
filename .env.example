# SQLite database file path
JOHNY_DB_PATH=johny_trade.db

# HTTP client resilience
JOHNY_REQUEST_TIMEOUT_SECONDS=10
JOHNY_REQUEST_RETRY_COUNT=3
JOHNY_REQUEST_RETRY_BACKOFF_SECONDS=1

# 15 minutes default short-term cycle
JOHNY_COLLECTION_INTERVAL_SECONDS=900

# Fresh-data policy
JOHNY_FRESHNESS_HOURS=24

# Logging
JOHNY_LOG_LEVEL=INFO
